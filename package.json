{
  "name": "gametok-backend",
  "version": "1.0.1",
  "description": "GameTok API backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "covers:backfill": "node scripts/cover-backfill.mjs --limit 50",
    "covers:backfill:all": "node scripts/cover-backfill.mjs --limit 500 --all",
    "covers:regenerate": "node regenerate-all-thumbnails.js",
    "covers:regenerate:test": "node regenerate-all-thumbnails.js --limit=5 --dry-run",
    "check:server": "node --check src/index.js && node --check src/cover-art.js && node --check src/cover-art-router.js && node --check scripts/cover-backfill.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@google/generative-ai": "^0.24.1",
    "@imgly/background-removal-node": "^1.4.5",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "expo-server-sdk": "^3.11.0",
    "express": "^4.18.2",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.7.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.33.0",
    "ora": "^9.4.0",
    "pg": "^8.20.0",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.20",
    "postcss": "^8.5.15",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tailwindcss": "^3.4.19",
    "three": "^0.182.0",
    "tiktoken": "^1.0.22",
    "typescript": "^6.0.3",
    "uuid": "^9.0.0",
    "vite": "^8.0.13",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "type": "module",
  "devDependencies": {
    "@types/three": "^0.182.0"
  }
}
